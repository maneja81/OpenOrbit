    "build": "tsc -b && electron-vite build",
    "build:web": "tsc -b && vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "better-sqlite3": "^13.0.1",
    "cheerio": "^1.2.0",
    "driver.js": "^1.8.0",
    "exceljs": "^3.10.0",
    "framer-motion": "^12.42.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "node-pptx-parser": "^1.0.1",
    "node-xlrd": "^0.3.10",
    "open-websearch": "^2.1.11",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
